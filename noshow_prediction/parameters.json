{
  "training": {
    "test_size": 0.2,
    "random_state": 42,
    "model_params": {
      "max_iter": 1000,
      "class_weight": "balanced",
      "solver": "lbfgs",
      "random_state": 42
    }
  },
  "evaluation": {
    "metric": "auc_roc",
    "minimum_threshold": 0.70,
    "improvement_threshold": 0.0
  },
  "scoring": {
    "prediction_threshold": 0.7,
    "risk_categories": {
      "very_high": 0.7,
      "high": 0.5,
      "medium": 0.3
    }
  },
  "data": {
    "features": [
      "age",
      "scholarship",
      "hipertension",
      "diabetes",
      "alcoholism",
      "handcap",
      "sms_received",
      "lead_time_days",
      "day_of_week",
      "chronic_conditions"
    ],
    "target": "no_show"
  }
}
